# Any OpenAI-compatible endpoint. Cloud now; vLLM or SGLang on your own GPU later (same three lines).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-me
LLM_MODEL=openai/gpt-oss-120b
# On-prem example:
# LLM_BASE_URL=http://gpu-box:8000/v1
# LLM_API_KEY=local
# LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_CONCURRENCY=8
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=6000
# Provider-specific extras as JSON (optional)
LLM_EXTRA_BODY={}
